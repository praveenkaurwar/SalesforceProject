    <label>Child Criteria</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>ANY</fullName>
                <default>true</default>
                <label>ANY</label>
            </value>
            <value>
                <fullName>ALL</fullName>
                <default>false</default>
                <label>ALL</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
